# A model key: set ONE of these two (if both are set, Claude is used unless
# LLM_PROVIDER says otherwise).
#
# Claude: chat on Opus 5.5, memory workers on Haiku 5.5.
# Get a key at https://console.anthropic.com (needs API credits).
ANTHROPIC_API_KEY=
#
# Gemini: chat on Gemini 3.6 Flash, memory workers on Gemini 3.5 Flash-Lite.
# Both have a free tier. Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Web search. Free tier: 1,000 credits/month, no card. Get one at
# https://app.tavily.com. Strongly recommended: with Gemini it's the only
# search backend; with Claude, leaving it empty falls back to Anthropic's
# built-in web search, which can't filter results by publish date.
TAVILY_API_KEY=

# ---- Optional ----------------------------------------------------------

# Force a provider when both keys are set: anthropic | gemini
# LLM_PROVIDER=gemini

# Model overrides (defaults depend on the provider, see above).
# AGENT_MODEL=claude-opus-5-5
# WORKER_MODEL=claude-haiku-5-5

# Reasoning effort for the chat model: low | medium | high (Gemini: thinking
# level). Low keeps replies fast; the hard parts (dates, memory lookup) are
# done in code anyway.
# AGENT_EFFORT=low

# Claude only. Opus 5.5 fast mode: up to ~2.5x faster output at premium pricing.
# FAST_MODE=false

# Freeze the clock for demos and evals (ISO 8601, any offset).
# Never set this in normal use; the UI shows a badge when it is on.
# NOW=2026-11-11T10:00:00+05:30

# Where the SQLite file lives.
# DB_PATH=data/chronicle.db

# API server port (the Vite dev server on :5173 proxies /api to it).
# API_PORT=8787

# Set to "off" to skip the local embedding model (memory search then uses
# keyword search only).
# EMBEDDINGS=on
