# Required. Powers the chat model (Claude Opus 5.5) and the background
# workers (Claude Haiku 5.5) that build memory after each turn.
ANTHROPIC_API_KEY=

# Recommended. Web search backend. Free tier: 1,000 credits/month, no card.
# Get one at https://app.tavily.com. If left empty, the agent falls back to
# Anthropic's built-in web search, which works with the key above but cannot
# filter results by publish date.
TAVILY_API_KEY=

# ---- Optional ----------------------------------------------------------

# Model overrides.
# AGENT_MODEL=claude-opus-5-5
# WORKER_MODEL=claude-haiku-5-5

# Reasoning effort for the chat model: low | medium | high. Low keeps replies
# fast; the hard parts (dates, memory lookup) are done in code anyway.
# AGENT_EFFORT=low

# Opus 5.5 fast mode: up to ~2.5x faster output at premium pricing.
# FAST_MODE=false

# Freeze the clock for demos and evals (ISO 8601, any offset).
# Never set this in normal use; the UI shows a badge when it is on.
# NOW=2026-11-11T10:00:00+05:30

# Where the SQLite file lives.
# DB_PATH=data/chronicle.db

# API server port (the Vite dev server on :5173 proxies /api to it).
# API_PORT=8787

# Set to "off" to skip the local embedding model (memory search then uses
# keyword search only).
# EMBEDDINGS=on
